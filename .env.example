# Aven API server (server/). Copy to .env and fill in. NEVER commit .env.
# These values are read only by the Node server. Do not prefix them with
# VITE_: anything starting with VITE_ is bundled into public browser code.

# Which AI provider to use. Only "openai" is implemented today.
AI_PROVIDER=openai
# Secret API key from https://platform.openai.com/api-keys (server-side only).
OPENAI_API_KEY=
# Required. Set to a chat model your OpenAI account can access. Check
# https://platform.openai.com/docs/models for current IDs; they change over time.
AI_MODEL=
# Optional: point at a different OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Port for the API server. The Vite dev server proxies /api here.
PORT=8787
# Comma-separated browser origins allowed to call the API (no trailing slash).
# For GitHub Pages use the origin only: https://jcodes101.github.io
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true only behind a trusted reverse proxy (Render, Railway, Fly, etc.).
TRUST_PROXY=false

# Tuning (optional)
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1200
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# --- Frontend (Vite) ---
# Public URL of the deployed Aven API, baked into the static build. This is a
# URL, not a secret. Leave empty for local dev (Vite proxies /api to PORT).
# VITE_AVEN_API_URL=https://your-aven-api.example.com
